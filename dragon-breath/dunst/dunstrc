[global]
    font = JetBrainsMono Nerd Font 10
    width = (280, 420)
    origin = top-right
    offset = 14x48
    frame_width = 2
    frame_color = "#00A86B"
    corner_radius = 10
    padding = 12
    horizontal_padding = 14

[urgency_low]
    background = "#0D0F12E6"
    foreground = "#E5E9F0"
    frame_color = "#00A86B"
    timeout = 3

[urgency_normal]
    background = "#0D0F12F2"
    foreground = "#D4AF37"
    frame_color = "#D4AF37"
    timeout = 6

[urgency_critical]
    background = "#161A20FF"
    foreground = "#E34234"
    frame_color = "#E34234"
    timeout = 0
