def _read_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {}


def _read_env_file():
    values = {}
    try:
        with open(ENV_FILE) as f:
            for line in f:
                m = re.match(r'\s*export\s+(\w+)="(.*)"\s*$', line)
                if m:
                    values[m.group(1)] = m.group(2)
    except OSError:
        pass
    return values


def default_model():
    """Ambiente -> estado do dragond -> dragon_env.sh -> modelo mínimo."""
    return (os.environ.get("DRAGON_MODEL")
            or _read_state().get("default_model")
            or _read_env_file().get("DRAGON_MODEL")
            or "qwen2.5-coder:1.5b")


def vision_model():
    return (os.environ.get("DRAGON_VISION_MODEL")
            or _read_state().get("vision_model")
            or _read_env_file().get("DRAGON_VISION_MODEL")
            or "moondream")


def load_prompts():
    """Prompts embutidos, sobrescritos por ~/.config/dragon-breath/prompts.json se existir.

    Aceita {"modo": "texto"} ou {"modo": {"system": "texto"}}.
    """
    prompts = dict(DEFAULT_PROMPTS)
    try:
        with open(PROMPTS_FILE) as f:
            for key, val in json.load(f).items():
                if isinstance(val, dict):
                    val = val.get("system")
                if isinstance(val, str) and val.strip():
                    prompts[key.lower()] = val
    except FileNotFoundError:
        pass
    except Exception as e:
        print(f"[dragonctl] prompts.json ignorado: {e}", file=sys.stderr)
    return prompts


# ============================================================================
# Cliente Ollama com conexão persistente
# ============================================================================

class OllamaError(Exception):
    pass


def _ollama_host():
    host = os.environ.get("OLLAMA_HOST", "127.0.0.1:11434")
    host = re.sub(r"^https?://", "", host).rstrip("/")
    if host.startswith("0.0.0.0"):
        host = "127.0.0.1" + host[len("0.0.0.0"):]
    if ":" not in host:
        host += ":11434"
    return host


class Ollama:
    """Um único socket HTTP/1.1 reaproveitado por todas as chamadas do processo."""

    def __init__(self, host=None):
        self.host = host or _ollama_host()
        self._conn = None

    def close(self):
        if self._conn is not None:
            self._conn.close()
            self._conn = None

    def _open(self, timeout):
        if self._conn is None:
            self._conn = http.client.HTTPConnection(self.host, timeout=timeout)
        else:
            self._conn.timeout = timeout
            if self._conn.sock is not None:
                self._conn.sock.settimeout(timeout)
        return self._conn

    def _send(self, path, body, timeout):
        data = json.dumps(body).encode("utf-8") if body is not None else None
        method = "POST" if body is not None else "GET"
        for attempt in range(2):
            conn = self._open(timeout)
            try:
                conn.request(method, path, body=data, headers={"Content-Type": "application/json"})
                return conn.getresponse()
            except (http.client.RemoteDisconnected, BrokenPipeError, ConnectionResetError) as e:
                # O servidor fechou a conexão keep-alive ociosa: reabre uma única vez
                self.close()
                if attempt:
                    raise OllamaError(f"Ollama indisponível em {self.host}: {e}") from e
            except OSError as e:
                self.close()
                raise OllamaError(f"Ollama indisponível em {self.host}: {e}") from e

    def call(self, path, body=None, timeout=60):
        resp = self._send(path, body, timeout)
        try:
            raw = resp.read()
        except OSError as e:
            self.close()
            raise OllamaError(f"Falha lendo resposta do Ollama: {e}") from e
        if resp.status >= 400:
            raise OllamaError(f"Ollama HTTP {resp.status}: {raw[:300].decode('utf-8', 'replace')}")
        return json.loads(raw or b"{}")

    def stream(self, path, body, timeout=120):
        resp = self._send(path, body, timeout)
        if resp.status >= 400:
            raw = resp.read()
            raise OllamaError(f"Ollama HTTP {resp.status}: {raw[:300].decode('utf-8', 'replace')}")
        try:
            for line in resp:
                line = line.strip()
                if line:
                    yield json.loads(line)
        except OSError as e:
            self.close()
            raise OllamaError(f"Streaming interrompido: {e}") from e

    def generate(self, prompt, system=None, model=None, images=None, options=None,
                 keep_alive="30m", timeout=60):
        body = {
            "model": model or default_model(),
            "prompt": prompt,
            "stream": False,
            "keep_alive": keep_alive,
            "options": options or {},
        }
        if system:
            body["system"] = system
        if images:
            body["images"] = images
        return self.call("/api/generate", body, timeout).get("response", "").strip()

    def embed(self, texts, timeout=60, keep_alive="5m"):
        data = self.call("/api/embed", {"model": EMBED_MODEL, "input": texts, "keep_alive": keep_alive}, timeout)
        return data["embeddings"]

    def loaded_models(self):
        return [m["name"] for m in self.call("/api/ps", None, 3).get("models", [])]

    def unload(self, model):
        self.call("/api/generate", {"model": model, "keep_alive": 0}, 15)


