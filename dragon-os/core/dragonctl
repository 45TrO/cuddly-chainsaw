def cmd_index(a):
    ol = Ollama()
    conn = db_connect()
    status = "ready"
    try:
        if a.all or not a.paths:
            set_scales_status("indexing", "Varredura completa")
            done, failed, removed = scan(conn, ol, WATCH_DIRS)
            print(f"[Scales] {done} indexado(s), {failed} falha(s), {removed} removido(s).")
            return 0 if not failed else 1
        rc = 0
        for p in a.paths:
            p = os.path.abspath(p)
            if not os.path.exists(p):
                remove_paths(conn, [p])
            elif os.path.isdir(p):
                for f in iter_files(p):
                    index_file(conn, ol, f)
            elif is_indexable(p):
                print(f"[Scales] {index_file(conn, ol, p)} trecho(s): {p}")
            else:
                print(f"[Scales] Tipo não indexável: {p}", file=sys.stderr)
                rc = 1
        return rc
    except OllamaError as e:
        print(f"[Scales] Ollama indisponível: {e}", file=sys.stderr)
        status = "offline"
        return 1
    finally:
        conn.close()
        set_scales_status(status)


def cmd_watch(a):
    """Indexação sob demanda: só reindexa o arquivo que acabou de ser salvo."""
    if not shutil.which("inotifywait"):
        print("[Scales] inotifywait não encontrado (instale inotify-tools).", file=sys.stderr)
        return 1
    dirs = [d for d in WATCH_DIRS if os.path.isdir(d)]
    if not dirs:
        print("[Scales] Nenhuma pasta monitorada existe; nada a fazer.")
        set_scales_status("ready", "Nenhuma pasta monitorada")
        return 0

    ol = Ollama()
    conn = db_connect()
    pending = {}  # caminho -> instante em que pode ser processado

    # Recupera o que mudou enquanto o serviço estava parado (só arquivos com mtime novo)
    set_scales_status("indexing", "Sincronizando alterações offline")
    try:
        done, failed, removed = scan(conn, ol, dirs)
        print(f"[Scales] Sincronização inicial: {done} indexado(s), {failed} falha(s), {removed} removido(s).")
        set_scales_status("ready")
    except OllamaError as e:
        print(f"[Scales] Ollama indisponível na partida, reagendando: {e}")
        set_scales_status("offline", str(e))
        for base in dirs:
            for path in iter_files(base):
                pending[path] = time.monotonic() + RETRY_S

    ignore_re = r"(^|/)(" + "|".join(re.escape(d) for d in sorted(IGNORE_DIRS)) + r")(/|$)"
    proc = subprocess.Popen(
        ["inotifywait", "-m", "-r", "-q", "--exclude", ignore_re,
         "-e", "close_write,moved_to,delete,moved_from", "--format", "%e\t%w%f", *dirs],
        stdout=subprocess.PIPE,
    )
    fd = proc.stdout.fileno()
    buf = b""
    print(f"[Scales] Monitorando: {', '.join(dirs)}")

    try:
        while True:
            ready, _, _ = select.select([fd], [], [], 1.0)
            if ready:
                data = os.read(fd, 65536)
                if not data:
                    print("[Scales] inotifywait terminou.", file=sys.stderr)
                    return 1
                buf += data
                *lines, buf = buf.split(b"\n")
                for raw in lines:
                    events, _, path = raw.decode("utf-8", "surrogateescape").partition("\t")
                    if not path:
                        continue
                    if "ISDIR" in events:
                        if "DELETE" in events or "MOVED_FROM" in events:
                            remove_prefix(conn, path)
                        elif "MOVED_TO" in events:
                            for f in iter_files(path):  # pasta movida para dentro: indexa o conteúdo
                                pending[f] = time.monotonic() + DEBOUNCE_S
                        continue
                    if is_indexable(path):
                        pending[path] = time.monotonic() + DEBOUNCE_S

            now = time.monotonic()
            due = [p for p, t in pending.items() if t <= now]
            if not due:
                continue
            set_scales_status("indexing", f"{len(due)} arquivo(s)")
            offline = False
            for path in due:
                pending.pop(path, None)
                try:
                    if not os.path.exists(path):
                        remove_paths(conn, [path])
                        continue
                    if not is_safe_file(path):
                        continue
                    todo, mtime = needs_index(conn, path)
                    if todo:
                        n = index_file(conn, ol, path, mtime)
                        print(f"[Scales] {n} trecho(s): {path}")
                except OllamaError as e:
                    print(f"[Scales] Ollama indisponível, nova tentativa em {RETRY_S:.0f}s: {e}")
                    offline = True
                    # Reagenda este e os demais do lote sem martelar o Ollama
                    for rest in due[due.index(path):]:
                        pending[rest] = time.monotonic() + RETRY_S
                    set_scales_status("offline", str(e))
                    break
                except Exception as e:
                    print(f"[Scales] Falha em {path}: {e}")
            if not offline:
                set_scales_status("ready")
    except KeyboardInterrupt:
        return 0
    finally:
        proc.terminate()
        conn.close()


def cmd_evict(a):
    ol = Ollama()
    try:
        running = ol.loaded_models()
    except OllamaError as e:
        print(f"{CINNABAR}{e}{RESET}", file=sys.stderr)
        return 1

    if not running:
        msg = "Nenhum modelo ocupando a VRAM no momento."
        print(f"{MIST}🐉 {msg}{RESET}")
        if not a.quiet:
            notify("🐉 dragonctl", msg)
        return 0

    evicted = []
    for name in running:
        try:
            ol.unload(name)
            evicted.append(name)
        except OllamaError as e:
            print(f"{CINNABAR}Erro ao descarregar {name}: {e}{RESET}")

    if evicted:
        joined = ", ".join(evicted)
        print(f"{JADE}🐉 VRAM liberada com sucesso! Descarregados: {GOLD}{joined}{RESET}")
        if not a.quiet:
            notify("🐉 VRAM Liberada", f"Modelos removidos da memória: {joined} — Motivo: {a.reason}")
