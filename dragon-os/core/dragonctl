def cmd_gen(a):
    prompts = load_prompts()
    if a.mode and a.mode not in prompts and not a.system:
        print(f"Modo desconhecido: {a.mode} (disponíveis: {', '.join(sorted(prompts))})", file=sys.stderr)
        return 2
    system = a.system or (prompts[a.mode] if a.mode else None)

    text = " ".join(a.text).strip()
    if not sys.stdin.isatty():
        piped = sys.stdin.read()
        if piped.strip():
            text = f"{text}\n\n{piped}" if text else piped
    if not text:
        print("Nada para enviar ao modelo.", file=sys.stderr)
        return 2

    options = {"temperature": a.temperature}
    if a.max_tokens:
        options["num_predict"] = a.max_tokens
    try:
        out = Ollama().generate(text, system=system, model=a.model, options=options, timeout=a.timeout)
    except OllamaError as e:
        print(str(e), file=sys.stderr)
        return 1
    if a.one_line:
        out = one_line(out)
    print(out)
    return 0 if out else 1


def cmd_ask(a):
    prompt = " ".join(a.text).strip()
    if not prompt:
        print("Uso: dragonctl ask <sua pergunta técnica>", file=sys.stderr)
        return 1
    model = a.model or default_model()
    body = {"model": model, "prompt": prompt, "stream": True, "keep_alive": "30m",
            "options": {"temperature": 0.2}}
    sys.stdout.write(f"\033[38;2;0;168;107m🐉 [{model}]: \033[0m")
    sys.stdout.flush()
    try:
        for part in Ollama().stream("/api/generate", body):
            sys.stdout.write(part.get("response", ""))
            sys.stdout.flush()
    except OllamaError as e:
        print(f"\n{e}", file=sys.stderr)
        return 1
    print()
    return 0


def cmd_breath(a):
    ol = Ollama()
    prompts = load_prompts()
    while True:
        query = rofi("🐉 Dragon Breath",
                     "Digite sua consulta ('@' inclui o texto copiado, '#' busca nos seus arquivos)")
        if not query:
            return 0

        sources = []
        if query.startswith("#"):
            clean = query[1:].strip()
            try:
                sources = scales_search(ol, clean, top_k=4)
            except (OllamaError, sqlite3.Error) as e:
                # Ollama fora do ar / índice indisponível: segue sem contexto
                query = f"(Aviso: falha ao consultar o índice Scales: {e}) {clean}"
            else:
                if sources:
                    blocks = "\n\n---\n".join(
                        f"[{s['file']}] (Relevância: {s['score']:.2f}):\n{s['content']}" for s in sources)
                    query = ("Use os seguintes trechos dos arquivos locais do usuário para responder.\n"
                             "Cite o nome do arquivo entre colchetes.\n\n"
                             f"{blocks}\n\nPergunta: {clean}")
                else:
                    query = f"(Aviso: Nenhum arquivo relevante encontrado no índice Scales) {clean}"
        elif query.startswith("@"):
            clean = query[1:].strip()
            clip = clipboard_text()
            query = f"Contexto da área de transferência:\n{clip}\n\nPergunta: {clean}" if clip else clean

        try:
            answer = ol.generate(query, system=prompts["breath"],
                                 options={"temperature": 0.1, "num_predict": 250}, timeout=30)
        except OllamaError as e:
            answer = f"Erro ao conectar ao Ollama: {e}"
        answer = answer or "Sem resposta do modelo."
        first_line = answer.split("\n")[0].strip("` ")

        actions = [
            "📋 Copiar resposta completa",
            f"⚡ Copiar 1ª linha ({first_line[:40]}...)",
            f"🖥️ Executar no terminal: {first_line[:40]}...",
            "🔄 Nova pergunta",
        ]
        if sources:
            actions.insert(0, f"📂 Abrir fonte principal: {sources[0]['file']}")

        choice = rofi("🐉 Ação", answer, actions)
        if choice.startswith("📂"):
            subprocess.Popen(["xdg-open", sources[0]["path"]])
        elif choice.startswith("📋"):
            copy_text(answer)
        elif choice.startswith("⚡"):
            copy_text(first_line)
        elif choice.startswith("🖥️"):
            # Abre o terminal executando o comando e mantendo a sessão aberta
            subprocess.Popen([terminal(), "-e", "sh", "-c", f"{first_line}; exec zsh"])
        elif choice.startswith("🔄"):
            continue
        return 0


