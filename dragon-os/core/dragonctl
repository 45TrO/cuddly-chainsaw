def db_connect():
    db_dir = os.path.dirname(DB_PATH)
    os.makedirs(db_dir, mode=0o700, exist_ok=True)
    os.chmod(db_dir, 0o700)  # o índice guarda trechos de todos os documentos
    old_umask = os.umask(0o077)
    try:
        conn = sqlite3.connect(DB_PATH, timeout=30)
    finally:
        os.umask(old_umask)
    os.chmod(DB_PATH, 0o600)
    conn.execute("PRAGMA foreign_keys = ON")    # sem isso o ON DELETE CASCADE é ignorado
    conn.execute("PRAGMA journal_mode = WAL")   # buscas não bloqueiam durante a indexação
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS files (
            path TEXT PRIMARY KEY,
            mtime REAL
        );
        CREATE TABLE IF NOT EXISTS chunks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            path TEXT,
            chunk_index INTEGER,
            content TEXT,
            embedding BLOB,
            FOREIGN KEY(path) REFERENCES files(path) ON DELETE CASCADE
        );
        CREATE INDEX IF NOT EXISTS idx_chunks_path ON chunks(path);
    """)
    return conn


def ensure_runtime_dir():
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)


