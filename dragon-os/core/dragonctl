def _eye_capture(path):
    """Seletor slurp com borda Verde Jade (#00A86B) e fundo Nanquim."""
    res = subprocess.run(["slurp", "-b", "0D0F1266", "-c", "00A86BFF", "-s", "00000000", "-w", "2"],
                         capture_output=True, text=True)
    region = res.stdout.strip()
    if not region:
        return False  # Usuário cancelou com ESC
    subprocess.run(["grim", "-g", region, path], check=True)
    return True


def _eye_ocr(path):
    if not shutil.which("tesseract"):
        return "Erro: 'tesseract' não instalado."
    res = subprocess.run(["tesseract", path, "stdout", "-l", "por+eng", "--psm", "6"],
                         capture_output=True, text=True)
    return res.stdout.strip() or "Nenhum texto detectado pelo OCR."


def _eye_vision(ol, path, prompt):
    model = vision_model()
    notify("👁️ Dragon Eye", f"Analisando imagem com {model}...", tag="dragon_eye")
    with open(path, "rb") as f:
        b64 = base64.b64encode(f.read()).decode("ascii")
    try:
        return ol.generate(prompt, model=model, images=[b64], keep_alive="10m",
                           options={"temperature": 0.1, "num_predict": 400}, timeout=45) \
            or "Sem resposta do modelo de visão."
    except OllamaError as e:
        return f"Erro ao consultar modelo de visão ({model}): {e}\nCertifique-se de ter rodado: ollama pull {model}"


def cmd_eye(a):
    ol = Ollama()
    # Captura vai para $XDG_RUNTIME_DIR (0700, só do usuário), não para o /tmp compartilhado
    fd, shot = tempfile.mkstemp(prefix="dragon_eye_", suffix=".png", dir=RUNTIME_DIR)
    os.close(fd)
    try:
        try:
            if not _eye_capture(shot):
                return 0
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            notify("👁️ Dragon Eye", f"Falha na captura de tela: {e}", urgency="normal", tag="dragon_eye")
            return 1

        choice = rofi("👁️ Dragon Eye",
                      "Selecione a ação para a região capturada (ou digite um prompt livre):",
                      [label for label, _ in EYE_MODES])
        if not choice:
            return 0

        if choice.startswith("🖼️"):
            with open(shot, "rb") as f:
                subprocess.run(["wl-copy", "--type", "image/png"], input=f.read())
            notify("👁️ Dragon Eye", "Imagem copiada para a área de transferência!", tag="dragon_eye")
            return 0
        if choice.startswith("⚡"):
            result = _eye_ocr(shot)
        else:
            prompt = next((p for label, p in EYE_MODES if p and choice == label), None)
            # Texto livre digitado no Rofi vira o próprio prompt
            result = _eye_vision(ol, shot, prompt or choice)

        next_step = rofi("👁️ Resultado", result, [
            "📋 Copiar resultado para o Clipboard",
            "🔄 Fazer outra pergunta sobre esta mesma captura",
            "❌ Fechar",
        ])
        if next_step.startswith("📋"):
            copy_text(result)
            notify("👁️ Dragon Eye", "Texto copiado para a área de transferência!", tag="dragon_eye")
        elif next_step.startswith("🔄"):
            question = rofi("👁️ Pergunta:", "O que você quer saber sobre a captura?")
            if question:
                answer = _eye_vision(ol, shot, question)
                copy_text(answer)
                rofi("👁️ Resposta (Já copiada!)", answer, ["✅ OK"])
        return 0
    finally:
        try:
            os.remove(shot)
        except OSError:
            pass


def cmd_search(a):
    try:
        results = scales_search(Ollama(), " ".join(a.query), top_k=a.top_k)
    except (OllamaError, sqlite3.Error) as e:
        print(str(e), file=sys.stderr)
        return 1
    if a.json:
        print(json.dumps(results, ensure_ascii=False, indent=2))
    else:
        for r in results:
            print(f"\033[38;2;212;175;55m[{r['score']:.2f}] {r['path']}\033[0m")
            print(r["content"][:300].replace("\n", " ") + "\n")
    return 0


def cmd_index(a):
    ol = Ollama()
    conn = db_connect()
    status = "ready"
    try:
        if a.all or not a.paths:
            set_scales_status("indexing", "Varredura completa")
            done, failed, removed = scan(conn, ol, WATCH_DIRS)
            print(f"[Scales] {done} indexado(s), {failed} falha(s), {removed} removido(s).")
            return 0 if not failed else 1
        rc = 0
        for p in a.paths:
            p = os.path.abspath(p)
            if not os.path.exists(p):
                remove_paths(conn, [p])
            elif os.path.isdir(p):
                for f in iter_files(p):
                    index_file(conn, ol, f)
            elif is_indexable(p):
                print(f"[Scales] {index_file(conn, ol, p)} trecho(s): {p}")
            else:
                print(f"[Scales] Tipo não indexável: {p}", file=sys.stderr)
                rc = 1
        return rc
    except OllamaError as e:
        print(f"[Scales] Ollama indisponível: {e}", file=sys.stderr)
        status = "offline"
        return 1
    finally:
        conn.close()
        set_scales_status(status)


def cmd_watch(a):
    """Indexação sob demanda: só reindexa o arquivo que acabou de ser salvo."""
    if not shutil.which("inotifywait"):
        print("[Scales] inotifywait não encontrado (instale inotify-tools).", file=sys.stderr)
        return 1
    dirs = [d for d in WATCH_DIRS if os.path.isdir(d)]
    if not dirs:
        print("[Scales] Nenhuma pasta monitorada existe; nada a fazer.")
        set_scales_status("ready", "Nenhuma pasta monitorada")
        return 0

    ol = Ollama()
    conn = db_connect()
    pending = {}  # caminho -> instante em que pode ser processado

    # Recupera o que mudou enquanto o serviço estava parado (só arquivos com mtime novo)
    set_scales_status("indexing", "Sincronizando alterações offline")
    try:
        done, failed, removed = scan(conn, ol, dirs)
        print(f"[Scales] Sincronização inicial: {done} indexado(s), {failed} falha(s), {removed} removido(s).")
        set_scales_status("ready")
    except OllamaError as e:
        print(f"[Scales] Ollama indisponível na partida, reagendando: {e}")
        set_scales_status("offline", str(e))
        for base in dirs:
            for path in iter_files(base):
                pending[path] = time.monotonic() + RETRY_S

    ignore_re = r"(^|/)(" + "|".join(re.escape(d) for d in sorted(IGNORE_DIRS)) + r")(/|$)"
    proc = subprocess.Popen(
        ["inotifywait", "-m", "-r", "-q", "--exclude", ignore_re,
         "-e", "close_write,moved_to,delete,moved_from", "--format", "%e\t%w%f", *dirs],
        stdout=subprocess.PIPE,
    )
    fd = proc.stdout.fileno()
    buf = b""
    print(f"[Scales] Monitorando: {', '.join(dirs)}")

    try:
        while True:
            ready, _, _ = select.select([fd], [], [], 1.0)
            if ready:
                data = os.read(fd, 65536)
                if not data:
                    print("[Scales] inotifywait terminou.", file=sys.stderr)
                    return 1
                buf += data
                *lines, buf = buf.split(b"\n")
                for raw in lines:
                    events, _, path = raw.decode("utf-8", "surrogateescape").partition("\t")
                    if not path:
                        continue
                    if "ISDIR" in events:
                        if "DELETE" in events or "MOVED_FROM" in events:
                            remove_prefix(conn, path)
                        elif "MOVED_TO" in events:
                            for f in iter_files(path):  # pasta movida para dentro: indexa o conteúdo
                                pending[f] = time.monotonic() + DEBOUNCE_S
                        continue
                    if is_indexable(path):
                        pending[path] = time.monotonic() + DEBOUNCE_S

            now = time.monotonic()
            due = [p for p, t in pending.items() if t <= now]
            if not due:
                continue
            set_scales_status("indexing", f"{len(due)} arquivo(s)")
            offline = False
            for path in due:
                pending.pop(path, None)
                try:
                    if not os.path.exists(path):
                        remove_paths(conn, [path])
                        continue
                    todo, mtime = needs_index(conn, path)
                    if todo:
                        n = index_file(conn, ol, path, mtime)
                        print(f"[Scales] {n} trecho(s): {path}")
                except OllamaError as e:
                    print(f"[Scales] Ollama indisponível, nova tentativa em {RETRY_S:.0f}s: {e}")
                    offline = True
                    # Reagenda este e os demais do lote sem martelar o Ollama
                    for rest in due[due.index(path):]:
                        pending[rest] = time.monotonic() + RETRY_S
                    set_scales_status("offline", str(e))
                    break
                except Exception as e:
                    print(f"[Scales] Falha em {path}: {e}")
            if not offline:
                set_scales_status("ready")
    except KeyboardInterrupt:
        return 0
    finally:
        proc.terminate()
        conn.close()


def cmd_evict(a):
    ol = Ollama()
    try:
        loaded = ol.loaded_models()
        for model in loaded:
            ol.unload(model)
    except OllamaError as e:
        print(str(e), file=sys.stderr)
        return 1
    if loaded:
        notify("🐉 dragond: VRAM Liberada",
               f"Modelos descarregados ({', '.join(loaded)}) — Motivo: {a.reason}")
    print(f"Descarregados: {', '.join(loaded) or 'nenhum'}")
    return 0


def cmd_warmup(a):
    model = a.model or default_model()
    try:
        Ollama().call("/api/generate", {"model": model, "keep_alive": "30m"}, timeout=180)
    except OllamaError as e:
        print(str(e), file=sys.stderr)
        return 1
    print(f"Modelo pronto na memória: {model}")
    return 0


def cmd_status(a):
    state = _read_state()
    print(f"Dragon OS {VERSION}")
    if state:
        print(f"  Tier      : {state.get('icon', '')} {state.get('tier', '?')} ({state.get('gpu_type', '?')})")
        print(f"  Memória   : {state.get('vram_used_mb', '?')}/{state.get('vram_total_mb', '?')} MB "
              f"({state.get('vram_pct', '?')}%)")
    else:
        print("  dragond   : sem estado (serviço parado?)")
    print(f"  Modelo    : {default_model()} | Visão: {vision_model()}")
    try:
        loaded = Ollama().loaded_models()
        print(f"  Na VRAM   : {', '.join(loaded) or 'nenhum'}")
    except OllamaError as e:
        print(f"  Ollama    : {e}")
    if os.path.exists(DB_PATH):
        conn = sqlite3.connect(DB_PATH, timeout=5)
        try:
            files = conn.execute("SELECT COUNT(*) FROM files").fetchone()[0]
            chunks = conn.execute("SELECT COUNT(*) FROM chunks").fetchone()[0]
            print(f"  Scales    : {files} arquivo(s), {chunks} trecho(s)")
        except sqlite3.Error as e:
            print(f"  Scales    : {e}")
        finally:
            conn.close()
    else:
        print("  Scales    : índice ainda não criado")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="dragonctl", description="CLI unificada de IA do Dragon OS")
    p.add_argument("--version", action="version", version=f"dragonctl {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("breath", help="Launcher IA no Rofi").set_defaults(fn=cmd_breath)
    sub.add_parser("eye", help="Captura de tela + OCR / visão").set_defaults(fn=cmd_eye)

    g = sub.add_parser("gen", help="Geração direta (texto por argumento e/ou stdin)")
    g.add_argument("-m", "--mode", type=str.lower, help="Prompt de sistema pré-definido (shell, wtf, commit, hoard...)")
    g.add_argument("-s", "--system", help="Prompt de sistema explícito")
    g.add_argument("--model")
    g.add_argument("-t", "--temperature", type=float, default=0.1)
    g.add_argument("-n", "--max-tokens", type=int)
    g.add_argument("--timeout", type=float, default=60)
    g.add_argument("-1", "--one-line", action="store_true", help="Retorna só a primeira linha útil")
    g.add_argument("text", nargs="*")
    g.set_defaults(fn=cmd_gen)

    k = sub.add_parser("ask", help="Pergunta com streaming")
    k.add_argument("--model")
    k.add_argument("text", nargs="*")
    k.set_defaults(fn=cmd_ask)

    s = sub.add_parser("search", help="Busca semântica no Scales")
    s.add_argument("-k", "--top-k", type=int, default=4)
    s.add_argument("--json", action="store_true")
    s.add_argument("query", nargs="+")
    s.set_defaults(fn=cmd_search)

    i = sub.add_parser("index", help="Indexa arquivos (ou tudo com --all)")
    i.add_argument("--all", action="store_true")
    i.add_argument("paths", nargs="*")
    i.set_defaults(fn=cmd_index)

    sub.add_parser("watch", help="Indexação contínua via inotify").set_defaults(fn=cmd_watch)

    e = sub.add_parser("evict", help="Descarrega todos os modelos da VRAM")
    e.add_argument("--reason", default="Pedido manual")
    e.set_defaults(fn=cmd_evict)

    w = sub.add_parser("warmup", help="Pré-carrega o modelo do Tier")
    w.add_argument("--model")
    w.set_defaults(fn=cmd_warmup)

    sub.add_parser("status", help="Estado do sistema de IA").set_defaults(fn=cmd_status)

    a = p.parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
