def _with_tag(name):
    return name if ":" in name else f"{name}:latest"


def cmd_model(a):
    if a.name and not MODEL_NAME_RE.match(a.name):
        print(f"{CINNABAR}Nome de modelo inválido: {a.name!r}{RESET}")
        return 1
    ol = Ollama()
    try:
        installed = ol.installed_models()
    except OllamaError as e:
        print(f"{CINNABAR}Erro ao consultar Ollama: {e}{RESET}")
        return 1

    current = default_model()
    if a.reset:
        try:
            os.remove(MODEL_OVERRIDE)
        except FileNotFoundError:
            pass
        tier_model = _read_state().get("tier_model") or _read_env_file().get("DRAGON_MODEL") or "?"
        print(f"{JADE}✅ Escolha manual removida: o dragond volta a usar o modelo do Tier ({GOLD}{tier_model}{RESET}{JADE}).{RESET}")
        return 0

    if not a.name:
        print(f"{JADE}{BOLD}🐉 Modelos Locais Disponíveis no Dragon OS:{RESET}")
        for name in installed:
            marker = f"{GOLD}★ [ATIVO]{RESET}" if _with_tag(name) == _with_tag(current) else ""
            print(f"  • {name} {marker}")
        print(f"\n{MIST}Use 'dragonctl model <nome>' para alternar o modelo global "
              f"('dragonctl model --reset' volta ao modelo do Tier).{RESET}")
        return 0

    target = a.name
    if _with_tag(target) not in {_with_tag(n) for n in installed}:
        print(f"{GOLD}⚠️ Modelo '{target}' não encontrado localmente. Baixando via Ollama...{RESET}")
        try:
            pulled = subprocess.run(["ollama", "pull", target]).returncode == 0
        except FileNotFoundError:
            pulled = False
        if not pulled:
            print(f"{CINNABAR}Falha ao baixar '{target}'. Modelo global não alterado.{RESET}")
            return 1

    # O dragond reescreve dragon_env.sh e o estado a cada 5s: a escolha fica num arquivo
    # próprio que ele respeita, em vez de ser sobrescrita pelo modelo do Tier.
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(MODEL_OVERRIDE, "w") as f:
        f.write(target + "\n")

    if a.warmup:
        print(f"{JADE}🔥 Pré-aquecendo {target} na VRAM...{RESET}")
        try:
            ol.call("/api/generate", {"model": target, "keep_alive": "30m"}, timeout=180)
        except OllamaError as e:
            print(f"{CINNABAR}Falha no pré-aquecimento: {e}{RESET}")

    print(f"{JADE}✅ Modelo global alterado para: {GOLD}{BOLD}{target}{RESET}")
    notify("🐉 Modelo Alterado", f"Novo cérebro ativo: {target}")
    return 0


