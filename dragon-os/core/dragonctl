def terminal():
    return os.environ.get("DRAGON_TERMINAL", "ghostty")


_CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def safe_text(text):
    """Remove caracteres de controle (ESC, BEL, C1...) mantendo \\n e \\t.

    Saída do modelo e trechos de documentos são dados não confiáveis: uma sequência
    OSC 52 (ESC ] 52), por exemplo, faria o terminal sobrescrever o clipboard.
    """
    return _CONTROL_RE.sub("", text)


def one_line(text):
    """Primeira linha útil de uma resposta, sem cercas markdown nem crases."""
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("```"):
            continue
        return safe_text(line.replace("`", "")).strip()
    return ""


