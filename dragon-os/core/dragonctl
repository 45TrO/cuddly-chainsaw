def is_indexable(path):
    if os.path.splitext(path)[1].lower() not in INDEX_EXTS:
        return False
    if SENSITIVE_NAME_RE.search(os.path.basename(path)):
        return False
    return not any(part in IGNORE_DIRS for part in path.split(os.sep))


def is_safe_file(path):
    """Arquivo regular de verdade: symlinks são ignorados (poderiam puxar ~/.ssh para o índice)."""
    return not os.path.islink(path) and os.path.isfile(path)


def iter_files(base):
    for root, dirs, files in os.walk(base):
        dirs[:] = [d for d in dirs if d not in IGNORE_DIRS]
        for name in files:
            path = os.path.join(root, name)
            if is_indexable(path) and is_safe_file(path):
                yield path


def extract_text(path):
    ext = os.path.splitext(path)[1].lower()
    if ext == ".pdf":
        import fitz  # PyMuPDF (import tardio: só quem indexa PDF paga o custo)
        with fitz.open(path) as doc:
            return "\n".join(page.get_text("text") for page in doc)
    if ext in CODE_EXTS:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            return f.read()
    return ""


def chunk_text(text, size=800, overlap=150):
    chunks = []
    start = 0
    while start < len(text):
        chunk = text[start:start + size].strip()
        if len(chunk) > 40:  # Ignora fragmentos muito pequenos
            chunks.append(chunk)
        start += size - overlap
    return chunks


def index_file(conn, ol, path, mtime=None):
    """Indexa um arquivo de forma atômica: ou entra tudo, ou nada muda."""
    import numpy as np
    if not is_safe_file(path):
        raise ValueError("não é um arquivo regular (symlink ignorado)")
    if mtime is None:
        mtime = os.path.getmtime(path)
    chunks = chunk_text(extract_text(path))

    # Gera todos os embeddings ANTES de tocar no banco
    rows = []
    for i in range(0, len(chunks), 32):
        batch = chunks[i:i + 32]
        # O nome do arquivo no texto melhora a precisão semântica
        contextual = [f"Arquivo: {os.path.basename(path)}\n{ch}" for ch in batch]
        for idx, (ch, vec) in enumerate(zip(batch, ol.embed(contextual))):
            emb = np.asarray(vec, dtype=np.float32)
            emb = emb / (np.linalg.norm(emb) + 1e-10)
            rows.append((path, i + idx, ch, emb.tobytes()))

    try:
        # UPSERT (e não INSERT OR REPLACE): REPLACE apagaria a linha-pai e,
        # com foreign_keys=ON, derrubaria os chunks em cascata.
        conn.execute(
            "INSERT INTO files (path, mtime) VALUES (?, ?) "
            "ON CONFLICT(path) DO UPDATE SET mtime = excluded.mtime",
            (path, mtime),
        )
        conn.execute("DELETE FROM chunks WHERE path = ?", (path,))
        conn.executemany(
            "INSERT INTO chunks (path, chunk_index, content, embedding) VALUES (?, ?, ?, ?)", rows
        )
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    return len(rows)


def remove_paths(conn, paths):
    rows = [(p,) for p in paths]
    if rows:
        conn.executemany("DELETE FROM chunks WHERE path = ?", rows)
        conn.executemany("DELETE FROM files WHERE path = ?", rows)
        conn.commit()
    return len(rows)


def remove_prefix(conn, directory):
    prefix = directory.rstrip(os.sep) + os.sep
    paths = [p for (p,) in conn.execute("SELECT path FROM files") if p.startswith(prefix)]
    return remove_paths(conn, paths)


def needs_index(conn, path):
    try:
        mtime = os.path.getmtime(path)
    except OSError:
        return False, None
    row = conn.execute("SELECT mtime FROM files WHERE path = ?", (path,)).fetchone()
    return (not row or row[0] < mtime), mtime


def scan(conn, ol, dirs, log=print):
    """Varredura incremental (por mtime) + remoção de arquivos que sumiram."""
    seen, scanned, done, failed = set(), [], 0, 0
    for base in dirs:
        if not os.path.isdir(base):
            continue  # pode estar desmontado: não apaga o que já foi indexado dele
        scanned.append(base)
        for path in iter_files(base):
            seen.add(path)
            todo, mtime = needs_index(conn, path)
            if not todo:
                continue
            log(f"[Scales] Indexando: {path}")
            try:
                index_file(conn, ol, path, mtime)
                done += 1
            except OllamaError:
                raise  # sem Ollama não adianta insistir arquivo por arquivo
            except Exception as e:
                failed += 1
                log(f"[Scales] Falha em {path}: {e}")

    stale = [p for (p,) in conn.execute("SELECT path FROM files")
             if p not in seen and any(p.startswith(d.rstrip(os.sep) + os.sep) for d in scanned)]
    removed = remove_paths(conn, stale)
    return done, failed, removed


def scales_search(ol, query, top_k=4, threshold=SCORE_THRESHOLD):
    if not os.path.exists(DB_PATH):
        return []
    import numpy as np
    q = np.asarray(ol.embed([query], timeout=10, keep_alive="15m")[0], dtype=np.float32)
    q = q / (np.linalg.norm(q) + 1e-10)

    conn = sqlite3.connect(DB_PATH, timeout=10)
    try:
        rows = conn.execute("SELECT path, content, embedding FROM chunks").fetchall()
    finally:
        conn.close()
    if not rows:
        return []

    matrix = np.frombuffer(b"".join(r[2] for r in rows), dtype=np.float32).reshape(len(rows), -1)
    scores = matrix @ q
    results = []
    for idx in np.argsort(scores)[::-1][:top_k]:
        if scores[idx] > threshold:  # Filtro mínimo de relevância
            path, content, _ = rows[idx]
            results.append({"file": os.path.basename(path), "path": path,
                            "score": float(scores[idx]), "content": content})
    return results


