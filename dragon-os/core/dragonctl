def _eye_capture(path):
    """Seletor slurp com borda Verde Jade (#00A86B) e fundo Nanquim."""
    res = subprocess.run(["slurp", "-b", "0D0F1266", "-c", "00A86BFF", "-s", "00000000", "-w", "2"],
                         capture_output=True, text=True)
    region = res.stdout.strip()
    if not region:
        return False  # Usuário cancelou com ESC
    subprocess.run(["grim", "-g", region, path], check=True)
    return True


def _eye_ocr(path):
    if not shutil.which("tesseract"):
        return "Erro: 'tesseract' não instalado."
    res = subprocess.run(["tesseract", path, "stdout", "-l", "por+eng", "--psm", "6"],
                         capture_output=True, text=True)
    return res.stdout.strip() or "Nenhum texto detectado pelo OCR."


def _eye_vision(ol, path, prompt):
    model = vision_model()
    notify("👁️ Dragon Eye", f"Analisando imagem com {model}...", tag="dragon_eye")
    with open(path, "rb") as f:
        b64 = base64.b64encode(f.read()).decode("ascii")
    try:
        return ol.generate(prompt, model=model, images=[b64], keep_alive="10m",
                           options={"temperature": 0.1, "num_predict": 400}, timeout=45) \
            or "Sem resposta do modelo de visão."
    except OllamaError as e:
        return f"Erro ao consultar modelo de visão ({model}): {e}\nCertifique-se de ter rodado: ollama pull {model}"


def cmd_eye(a):
    ol = Ollama()
    # Captura vai para $XDG_RUNTIME_DIR (0700, só do usuário), não para o /tmp compartilhado
    ensure_runtime_dir()
    fd, shot = tempfile.mkstemp(prefix="dragon_eye_", suffix=".png", dir=RUNTIME_DIR)
    os.close(fd)
    try:
        try:
            if not _eye_capture(shot):
                return 0
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            notify("👁️ Dragon Eye", f"Falha na captura de tela: {e}", urgency="normal", tag="dragon_eye")
            return 1

        choice = rofi("👁️ Dragon Eye",
                      "Selecione a ação para a região capturada (ou digite um prompt livre):",
                      [label for label, _ in EYE_MODES])
        if not choice:
            return 0

        if choice.startswith("🖼️"):
            with open(shot, "rb") as f:
                subprocess.run(["wl-copy", "--type", "image/png"], input=f.read())
            notify("👁️ Dragon Eye", "Imagem copiada para a área de transferência!", tag="dragon_eye")
            return 0
        if choice.startswith("⚡"):
            result = _eye_ocr(shot)
        else:
            prompt = next((p for label, p in EYE_MODES if p and choice == label), None)
            # Texto livre digitado no Rofi vira o próprio prompt
            result = _eye_vision(ol, shot, prompt or choice)

        next_step = rofi("👁️ Resultado", result, [
            "📋 Copiar resultado para o Clipboard",
            "🔄 Fazer outra pergunta sobre esta mesma captura",
            "❌ Fechar",
        ])
        if next_step.startswith("📋"):
            copy_text(result)
            notify("👁️ Dragon Eye", "Texto copiado para a área de transferência!", tag="dragon_eye")
        elif next_step.startswith("🔄"):
            question = rofi("👁️ Pergunta:", "O que você quer saber sobre a captura?")
            if question:
                answer = _eye_vision(ol, shot, question)
                copy_text(answer)
                rofi("👁️ Resposta (Já copiada!)", answer, ["✅ OK"])
        return 0
    finally:
        try:
            os.remove(shot)
        except OSError:
            pass


