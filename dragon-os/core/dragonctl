def main(argv=None):
    p = argparse.ArgumentParser(prog="dragonctl",
                                description=f"🐉 dragonctl (龙控) - Orquestrador Central do Dragon OS v{VERSION}")
    p.add_argument("--version", action="version", version=f"dragonctl {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("breath", help="Launcher IA no Rofi").set_defaults(fn=cmd_breath)
    sub.add_parser("eye", help="Captura de tela + OCR / visão").set_defaults(fn=cmd_eye)

    g = sub.add_parser("gen", help="Geração direta (texto por argumento e/ou stdin)")
    g.add_argument("-m", "--mode", type=str.lower, help="Prompt de sistema pré-definido (shell, wtf, commit, hoard...)")
    g.add_argument("-s", "--system", help="Prompt de sistema explícito")
    g.add_argument("--model")
    g.add_argument("-t", "--temperature", type=float, default=0.1)
    g.add_argument("-n", "--max-tokens", type=int)
    g.add_argument("--timeout", type=float, default=60)
    g.add_argument("-1", "--one-line", action="store_true", help="Retorna só a primeira linha útil")
    g.add_argument("text", nargs="*")
    g.set_defaults(fn=cmd_gen)

    k = sub.add_parser("ask", help="Pergunta com streaming")
    k.add_argument("--model")
    k.add_argument("text", nargs="*")
    k.set_defaults(fn=cmd_ask)

    sc = sub.add_parser("scales", help="Busca semântica ou reindexação do módulo Scales (RAG)")
    sc.add_argument("scales_action", choices=["search", "reindex"], help="Ação do Scales")
    sc.add_argument("query", nargs="*", help="Termo de busca semântica")
    sc.add_argument("-k", "--top-k", type=int, default=4, help="Número de resultados (padrão: 4)")
    sc.add_argument("--json", action="store_true", help="Retorna saída em JSON puro")
    sc.set_defaults(fn=cmd_scales)

    s = sub.add_parser("search", help="Atalho para 'scales search'")
    s.add_argument("-k", "--top-k", type=int, default=4)
    s.add_argument("--json", action="store_true")
    s.add_argument("query", nargs="+")
    s.set_defaults(fn=cmd_search)

    i = sub.add_parser("index", help="Indexa arquivos específicos (ou tudo com --all)")
    i.add_argument("--all", action="store_true")
    i.add_argument("paths", nargs="*")
    i.set_defaults(fn=cmd_index)

    sub.add_parser("watch", help="Indexação contínua via inotify (serviço)").set_defaults(fn=cmd_watch)

    st = sub.add_parser("status", help="Exibe telemetria de VRAM, modelos e daemons")
    st.add_argument("--waybar", action="store_true", help="Saída JSON formatada para a Waybar")
    st.set_defaults(fn=cmd_status)

    e = sub.add_parser("evict", help="Descarrega todos os modelos da VRAM imediatamente")
    e.add_argument("-q", "--quiet", action="store_true", help="Não envia notificação desktop")
    e.add_argument("--reason", default="Pedido manual")
    e.set_defaults(fn=cmd_evict)

    m = sub.add_parser("model", help="Lista ou troca o modelo padrão do Dragon OS")
    m.add_argument("name", nargs="?", help="Nome do modelo no Ollama (ex: qwen2.5-coder:7b)")
    m.add_argument("-w", "--warmup", action="store_true", help="Já carrega o modelo na VRAM")
    m.add_argument("--reset", action="store_true", help="Volta ao modelo definido pelo Tier")
    m.set_defaults(fn=cmd_model)

    w = sub.add_parser("warmup", help="Pré-carrega o modelo padrão na memória")
    w.add_argument("--model")
    w.set_defaults(fn=cmd_warmup)

    sub.add_parser("sanctuary", help="Alterna o Modo Santuário (Foco Profundo)").set_defaults(fn=cmd_sanctuary)

    a = p.parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
