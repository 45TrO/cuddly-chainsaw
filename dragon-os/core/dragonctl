def notify(title, body, urgency="low", timeout_ms=3500, tag="dragonctl"):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-u", urgency, "-t", str(timeout_ms),
                          "-h", f"string:x-canonical-private-synchronous:{tag}", title, body])


def rofi(prompt, message="", options=None):
    cmd = ["rofi", "-dmenu", "-p", prompt, "-theme", ROFI_THEME]
    if message:
        # -mesg interpreta Pango markup: '<', '>' e '&' (ex.: "2>&1") quebrariam a mensagem
        cmd += ["-mesg", html.escape(message, quote=False)]
    proc = subprocess.run(cmd, input="\n".join(options or []), text=True, capture_output=True)
    return proc.stdout.strip()


def clipboard_text(limit=1000):
    try:
        res = subprocess.run(["wl-paste", "-n"], capture_output=True, text=True, timeout=0.5)
        return res.stdout.strip()[:limit]
    except Exception:
        return ""


def copy_text(text):
    subprocess.run(["wl-copy"], input=text, text=True)


def terminal():
    return os.environ.get("DRAGON_TERMINAL", "ghostty")


def one_line(text):
    """Primeira linha útil de uma resposta, sem cercas markdown nem crases."""
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("```"):
            continue
        return line.replace("`", "").strip()
    return ""


