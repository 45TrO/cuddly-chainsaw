# ============================================================================
# 🐉 DRAGON OS (龙) - Tema Plymouth "Ink & Jade"
# Fases 1-3 da abertura: log em jade -> nanquim -> dragão de jade em voo.
# Os quadros frame-000.png... são gerados por boot/make-boot-assets.sh;
# FRAME_COUNT é preenchido na instalação (install-boot-splash.sh).
# ============================================================================

FRAME_COUNT = @FRAME_COUNT@;
TICKS_PER_FRAME = 4;            # o Plymouth chama refresh ~50x/s -> ~12 quadros/s

Window.SetBackgroundTopColor(0.051, 0.059, 0.071);     # #0D0F12 Nanquim
Window.SetBackgroundBottomColor(0.051, 0.059, 0.071);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

frame_sprite = Sprite();
frame_sprite.SetZ(0);
current_frame = -1;
tick = 0;

fun frame_name(i) {
    if (i < 10) return "frame-00" + i + ".png";
    if (i < 100) return "frame-0" + i + ".png";
    return "frame-" + i + ".png";
}

# Carrega um quadro por vez (não guarda todos na memória) e cobre a tela inteira
fun show_frame(i) {
    img = Image(frame_name(i));
    ratio = Math.Max(screen_w / img.GetWidth(), screen_h / img.GetHeight());
    scaled = img.Scale(Math.Int(img.GetWidth() * ratio), Math.Int(img.GetHeight() * ratio));
    frame_sprite.SetImage(scaled);
    frame_sprite.SetX(Math.Int((screen_w - scaled.GetWidth()) / 2));
    frame_sprite.SetY(Math.Int((screen_h - scaled.GetHeight()) / 2));
    current_frame = i;
}

fun refresh_callback() {
    if (Plymouth.GetMode() != "boot") {
        # Desligar / reiniciar: só o último quadro (dragão enrolado), sem animação
        if (current_frame != FRAME_COUNT - 1) show_frame(FRAME_COUNT - 1);
        return;
    }
    tick++;
    f = Math.Int(tick / TICKS_PER_FRAME);
    if (f >= FRAME_COUNT) f = FRAME_COUNT - 1;   # segura o último quadro até o boot terminar
    if (f != current_frame) show_frame(f);
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Fase 1: mensagens de boot em verde jade, estilo terminal, no canto inferior ---
message_sprite = Sprite();
message_sprite.SetZ(10);

fun message_callback(text) {
    message_sprite.SetImage(Image.Text(text, 0.0, 0.659, 0.42, 1, "Monospace 11"));
    message_sprite.SetX(24);
    message_sprite.SetY(screen_h - 40);
}
Plymouth.SetMessageFunction(message_callback);

# --- Senha do disco (LUKS): sem isso o boot travaria em discos criptografados ---
prompt_sprite = Sprite();
prompt_sprite.SetZ(20);
bullets_sprite = Sprite();
bullets_sprite.SetZ(20);

fun display_password_callback(prompt, bullets) {
    prompt_img = Image.Text(prompt, 0.831, 0.686, 0.216, 1, "Sans 13");   # Dourado Celestial
    prompt_sprite.SetImage(prompt_img);
    prompt_sprite.SetX(Math.Int((screen_w - prompt_img.GetWidth()) / 2));
    prompt_sprite.SetY(Math.Int(screen_h * 0.78));

    dots = "";
    for (i = 0; i < bullets; i++) dots += "● ";
    if (dots == "") dots = " ";
    dots_img = Image.Text(dots, 0.0, 0.659, 0.42, 1, "Sans 16");          # Verde Jade
    bullets_sprite.SetImage(dots_img);
    bullets_sprite.SetX(Math.Int((screen_w - dots_img.GetWidth()) / 2));
    bullets_sprite.SetY(Math.Int(screen_h * 0.78) + 32);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt, entry) {
    display_password_callback(prompt + " " + entry, 0);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback() {
    prompt_sprite.SetImage(Image.Text(" ", 0, 0, 0, 0));
    bullets_sprite.SetImage(Image.Text(" ", 0, 0, 0, 0));
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
